# ─────────────────────────────────────────────────────────────
# Dewasa Ayu — environment template
# Copy to `.env` and adjust. NEVER commit a real `.env` (gitignored).
# The defaults below match docker/docker-compose.yml (local development).
# ─────────────────────────────────────────────────────────────

# PostgreSQL — used by Prisma (datasource db.url)
DATABASE_URL="postgresql://dewasa:dewasa@localhost:5432/dewasa_ayu?schema=public"

# Redis — cache & rate limiting
REDIS_URL="redis://localhost:6379"

# Runtime
NODE_ENV="development"
