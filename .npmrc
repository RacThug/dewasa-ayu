# Enforce the Node/pnpm versions declared in package.json "engines"
engine-strict=true

# Auto-install peer deps (pnpm default; explicit for clarity)
auto-install-peers=true

# Keep pnpm's strict, isolated node_modules — do NOT flatten/hoist.
# Hoisting hides phantom-dependency bugs; the monorepo relies on real deps.
shamefully-hoist=false
